# ===== API Gateway (puerto 4000) =====
PORT=4000

# Secreto para firmar los JWT. DEBE ser el MISMO valor en los 4 servicios (gateway, Node, Python y PHP).
# Mínimo 32 caracteres. Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Límite de intentos fallidos de login por IP
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Base de datos (para usuarios y refresh tokens)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taller_automotriz

# Microservicios (RAMA -> URL base)
PHP_SERVICE_URL=http://127.0.0.1:8000
PYTHON_SERVICE_URL=http://127.0.0.1:5000
NODE_SERVICE_URL=http://127.0.0.1:3000
SERVICE_TIMEOUT_MS=10000

# Orígenes del frontend permitidos por CORS (separados por coma)
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
